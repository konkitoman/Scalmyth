{
  "multipart": [
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_middle"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_middle",
        "y": 90
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_middle",
        "y": 180
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_middle",
        "y": 270
      }
    },
    {
      "when": {
        "OR": [
          {"west": true},
          {"north": true}
        ]
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_corner_left"
      }
    },
    {
      "when": {
        "OR": [
          {"north": true},
          {"east": true}
        ]
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_corner_right"
      }
    },
    {
      "when": {
        "OR": [
          {"east": true},
          {"south": true}
        ]
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_corner_left",
        "y": 180
      }
    },
    {
      "when": {
        "OR": [
          {"south": true},
          {"west": true}
        ]
      },
      "apply": {
        "model": "scalmyth:block/wall_v2_corner_right",
        "y": 180
      }
    }
  ]
}